{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mui-api",
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "compatibility_date": "2026-03-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",
  "durable_objects": {
    "bindings": [
      {
        "name": "CONCURRENCY_LIMITER",
        "class_name": "ConcurrencyLimiterDO"
      },
      {
        "name": "WALLET",
        "class_name": "WalletDO"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mui-api",
      "database_id": "cac559c7-48f0-4720-8d5a-db017864a279"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "aeab02ed56cc4d2ca6e8558aa90b8663"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": false
  },
  "placement": {
    "mode": "smart"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConcurrencyLimiterDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WalletDO"]
    }
  ],
  "triggers": {
    "crons": ["5 * * * *", "15 0 * * *", "30 0 * * 1", "45 0 1 * *"]
  },
  "vars": {
    "DEFAULT_MAX_CONCURRENCY": 3,
    "CF_ACCOUNT_ID": "fdc63eeea83ae8f5234357308b9a638b",
    "CF_GATEWAY_ID": "api-router",
    "MIMO_BASE_URL": "https://token-plan-cn.xiaomimimo.com/v1",
    "OPENCODE_GO_BASE_URL": "https://opencode.ai/zen/go/v1"
  }
}
