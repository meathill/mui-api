{
  "name": "mui-api",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@google/genai": "^3.6.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@muirouter/shared-db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.20",
    "openai": "^7.62.0",
    "resend": "^6.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-ssr-components": "^0.9.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
