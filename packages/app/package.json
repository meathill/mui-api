{
  "name": "mui-api",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^1.50.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@muirouter/shared-db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.9",
    "openai": "^6.34.0",
    "resend": "^6.9.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.1",
    "@cloudflare/vitest-pool-workers": "^0.13.4",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@vitest/coverage-v8": "4.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-ssr-components": "^0.5.2",
    "vitest": "^4.1.1",
    "wrangler": "^4.120.0"
  }
}
