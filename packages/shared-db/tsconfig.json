{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["src", "scripts", "dev-config.ts", "drizzle.config.ts"],
  "exclude": ["node_modules"]
}
