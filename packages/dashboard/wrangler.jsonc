{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mui-api-dashboard",
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "WALLET",
        "class_name": "WalletDO",
        "script_name": "mui-api"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mui-api",
      "database_id": "cac559c7-48f0-4720-8d5a-db017864a279"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "aeab02ed56cc4d2ca6e8558aa90b8663",
      "preview_id": "aeab02ed56cc4d2ca6e8558aa90b8663"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "observability": {
    "enabled": false
  },
  "placement": {
    "mode": "smart"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "site-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mui-api-dashboard"
    },
    {
      "binding": "MUICV_CMS",
      "service": "muicv-cms"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_BASE": "https://api.muirouter.com",
    "NEXT_PUBLIC_SITE_URL": "https://muirouter.com",
    "ADMIN_EMAILS": "meathill@gmail.com",
    "BETTER_AUTH_URL": "https://muirouter.com",
    "GITHUB_CLIENT_ID": "Ov23liArbpaCvUyzy7di",
    "GOOGLE_CLIENT_ID": "553490336811-mmarli7qmgmcsllqbrs9bnr116pj145o.apps.googleusercontent.com",
    "MIMO_BASE_URL": "https://token-plan-cn.xiaomimimo.com/v1"
  }
}
