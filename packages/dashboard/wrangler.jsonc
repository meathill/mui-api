{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mui-dashboard",
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mui-dashboard"
    }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mui-api",
      "database_id": "cac559c7-48f0-4720-8d5a-db017864a279"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "aeab02ed56cc4d2ca6e8558aa90b8663",
      "preview_id": "aeab02ed56cc4d2ca6e8558aa90b8663"
    }
  ]
}
