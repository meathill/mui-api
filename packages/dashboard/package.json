{
  "name": "mui-api-dashboard",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3035",
    "build": "pnpm run cf-typegen && next build && node ./scripts/check-render-modes.ts",
    "deploy": "pnpm run cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "pnpm run cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "pnpm run cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "test": "vitest run",
    "test:e2e:prepare": "node scripts/prepare-e2e.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "submit:indexnow": "node scripts/submit-indexnow.ts",
    "check:cms-seo": "node scripts/check-cms-seo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@muirouter/shared-db": "workspace:*",
    "@next/mdx": "~16.4.6",
    "@next/third-parties": "^16.4.6",
    "@opennextjs/cloudflare": "^1.20.18",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "mermaid": "^12.3.0",
    "next": "~16.4.6",
    "next-intl": "^4.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "stripe": "23.2.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@next/playwright": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/expect": "5.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "5.1.1",
    "wrangler": "^4.166.0"
  }
}
