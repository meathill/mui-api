{
  "name": "mui-api-dashboard",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3035",
    "build": "next build && node ./scripts/check-render-modes.ts",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "test": "vitest run",
    "test:e2e:prepare": "node scripts/prepare-e2e.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "submit:indexnow": "node scripts/submit-indexnow.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@muirouter/shared-db": "workspace:*",
    "@next/mdx": "~16.3.0",
    "@next/third-parties": "^16.3.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "mermaid": "^11.4.1",
    "next": "~16.3.0",
    "next-intl": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "stripe": "22.4.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "@next/playwright": "16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/expect": "4.1.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  }
}
