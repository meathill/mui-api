{
  "name": "mui-api-dashboard",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3035",
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "test": "vitest run",
    "test:e2e:prepare": "node scripts/prepare-e2e.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "submit:indexnow": "node scripts/submit-indexnow.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@muirouter/shared-db": "workspace:*",
    "@next/mdx": "~16.2.9",
    "@next/third-parties": "^16.2.1",
    "@opennextjs/cloudflare": "^1.17.3",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next": "~16.2.9",
    "next-intl": "^4.8.4",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.4",
    "stripe": "21.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.1",
    "wrangler": "^4.77.0"
  }
}
